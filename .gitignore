# =============================================
# CountYOLO — .gitignore
# =============================================

# --- Dữ liệu lớn (lưu trên Google Drive, không push lên GitHub) ---
data/
*.pt
*.pth
*.ckpt
*.bin
*.h5

# --- Log & Output ---
*.log
*.txt
pipeline_log.txt
pipeline_output.log
train_debug.txt
llm_test.txt
checkpoint_epoch_*.pth

# --- Python Cache ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/
dist/
build/
*.egg

# --- IDE & OS ---
.vscode/
.idea/
*.DS_Store
Thumbs.db

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb

# --- Môi trường ảo ---
venv/
env/
.env
*.env

# --- Hugging Face cache (weights tải về, không cần push) ---
.cache/

# --- WandB ---
wandb/
