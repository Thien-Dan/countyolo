# =============================================
# CountYOLO — .gitignore
# =============================================

# --- Dữ liệu lớn (lưu trên Google Drive, không push lên GitHub) ---
data/
*.pt
*.pth
*.ckpt
*.bin
*.h5

# --- Log & Output ---
*.log
pipeline_log.txt
pipeline_output.log
train_debug.txt
llm_test.txt
checkpoint_epoch_*.pth

# --- Python Cache ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/
dist/
build/
*.egg

# --- IDE & OS ---
.vscode/
.idea/
*.DS_Store
Thumbs.db

# --- Jupyter (chỉ bỏ checkpoint, giữ notebook) ---
.ipynb_checkpoints/

# --- Môi trường ảo ---
venv/
env/
.env
*.env

# --- Hugging Face cache (weights tải về, không cần push) ---
.cache/

# --- WandB ---
wandb/

# --- Kaggle API tokens (bí mật, không bao giờ commit) ---
kaggle/
kaggle_run/
kaggle_countvid_run/
kaggle_bench_run/

# --- Checkpoint tốt nhất (head ~2.4MB, YOLO-World + DINOv2-small, test MAE 18.90) được giữ lại ---
!checkpoints/density_head_best_vit_seed3_ep19_valmae21.44.pth

# --- Môi trường ảo của dự án ---
.venv/

# --- Kết quả chạy tool / UI ---
outputs/
kaggle_sam3_ds/
