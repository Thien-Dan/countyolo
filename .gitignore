# =============================================
# CountYOLO — .gitignore
# =============================================

# --- Dữ liệu lớn (lưu trên Google Drive, không push lên GitHub) ---
data/
*.pt
*.pth
*.ckpt
*.bin
*.h5

# --- Log & Output ---
*.log
pipeline_log.txt
pipeline_output.log
train_debug.txt
llm_test.txt
checkpoint_epoch_*.pth

# --- Python Cache ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/
dist/
build/
*.egg

# --- IDE & OS ---
.vscode/
.idea/
*.DS_Store
Thumbs.db

# --- Jupyter (chỉ bỏ checkpoint, giữ notebook) ---
.ipynb_checkpoints/

# --- Môi trường ảo ---
venv/
env/
.env
*.env

# --- Hugging Face cache (weights tải về, không cần push) ---
.cache/

# --- WandB ---
wandb/

# --- Kaggle API tokens (bí mật, không bao giờ commit) ---
kaggle/
kaggle_run/
kaggle_countvid_run/
kaggle_bench_run/

# --- Selected CountYOLO heads; migrate to DVC after remote verification ---
!checkpoints/density_head_best_vit_seed3_ep19_valmae21.44.pth
!checkpoints/density_head_best_vit_exnoise.pth
!checkpoints/density_head_best_vit_exmix2_ep20.pth
checkpoints/countgd_box*

# --- Môi trường ảo của dự án ---
.venv/
.kaggle-tools/
.uv-cache/
kaggle_video_run/

# --- Kết quả chạy tool / UI ---
outputs/
kaggle_sam3_ds/

experiments/*.lock

# Per-machine queue state (experiment findings are in experiments/LOG.md)
experiments/video_tasks.json
experiments/video_diagnostics.json
experiments/sam3_memory_tasks.json
